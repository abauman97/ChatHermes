# Pass this variable to the Node proxy process in a private environment.
# Each entry needs a distinct strong key. URLs must be loopback Hermes roots
# or loopback shared-gateway /p/<profile>/ prefixes.
CHATHERMES_PROFILES_JSON='[{"id":"default","label":"Default","url":"http://127.0.0.1:8642/","key":"REPLACE_WITH_STRONG_DEFAULT_KEY"},{"id":"work","label":"Work","url":"http://127.0.0.1:8643/","key":"REPLACE_WITH_DIFFERENT_STRONG_WORK_KEY"}]'
CHATHERMES_PORT=8787
