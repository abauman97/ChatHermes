{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "allowJs": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["workflows/**/*.ts", "docker/*.mjs", "visual/login.ts"]
}
