{
  "name": "chathermes",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vue-tsc -b && node scripts/build-plugin.mjs",
    "test": "vp test run",
    "build:plugin": "vue-tsc -b && node scripts/build-plugin.mjs",
    "install:plugin": "node scripts/install-plugin.mjs",
    "test:api": "python3 -m pytest tests/plugin_api.test.py",
    "test:visual": "playwright test",
    "live": "npm run build && sh tests/docker/run.sh fixture",
    "live:real": "npm run build && sh tests/docker/run.sh real",
    "live:stop": "sh tests/docker/run.sh stop",
    "live:visual": "npm run live && npm run test:visual",
    "test:native": "sh tests/docker/native-tests.sh",
    "test:docker": "python3 -m unittest discover -s tests/docker -p \"test_*.py\"",
    "prepare": "vp config"
  },
  "dependencies": {
    "markdown-it": "^15.0.2",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0",
    "vite-plus": "1.1.0",
    "vue-tsc": "^3.3.11"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0"
  }
}
