{
  "name": "chathermes",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vue-tsc -b && node scripts/build-plugin.mjs",
    "test": "vp test run",
    "build:plugin": "vue-tsc -b && node scripts/build-plugin.mjs",
    "install:plugin": "node scripts/install-plugin.mjs",
    "test:api": "python3 -m pytest tests/plugin_api.test.py",
    "test:visual": "playwright test",
    "test:visual:legacy": "CHATHERMES_TEST_SUITE=legacy playwright test",
    "live": "sh tests/docker/run.sh",
    "live:real": "sh tests/docker/run.sh real",
    "live:stop": "sh tests/docker/run.sh stop",
    "live:visual": "npm run test:integration",
    "test:docker": "python3 -m unittest discover -s tests/docker -p \"test_*.py\"",
    "prepare": "vp config",
    "test:live": "npm run live",
    "live:android": "sh tests/docker/android.sh",
    "live:android:stop": "sh tests/docker/android.sh stop",
    "test:live:android": "sh tests/docker/android.sh",
    "test:integration": "node tests/docker/integration.mjs",
    "test:integration:android": "node tests/docker/integration.mjs --android",
    "test:fixtures": "node tests/docker/load-fixtures.mjs",
    "test:browser": "node tests/docker/prepare-browser.mjs",
    "test:android:prepare": "node tests/docker/prepare-browser.mjs --android",
    "test:android:install": "node tests/docker/android-install.mjs",
    "test:env:build": "npm run build && docker compose --project-directory . -f tests/docker/compose.yml build --pull hermes"
  },
  "dependencies": {
    "markdown-it": "^15.0.2",
    "vue": "^3.5.42",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0",
    "vite-plus": "1.1.0",
    "vue-tsc": "^3.3.11"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0"
  }
}
